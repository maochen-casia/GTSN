{
  "device": "cuda",
  "batch_size": 64,
  "num_workers": 8,
  "frame_stride": 1,
  "execute_horizon": 5,
  "max_control_steps": 400,
  "physics_hz": 240,
  "control_hz": 20,
  "goal_position_tolerance_m": 0.01,
  "goal_orientation_tolerance_rad": 0.15,
  "stop_on_collision": true,
  "contact_impulse_threshold_ns": 1e-7,
  "render_videos": true,
  "video_stride": 2,
  "arm_stiffness": 1000.0,
  "arm_damping": 100.0,
  "arm_force_limit": 100.0,
  "finger_stiffness": 1000.0,
  "finger_damping": 100.0,
  "finger_force_limit": 100.0,
  "ee_link": "panda_hand_tcp",
  "table_center_m": [0.45, 0.0, -0.025],
  "table_half_size_m": [0.65, 0.55, 0.025],
  "base_position_m": [0.0, 0.0, 0.0],
  "cylinder_kinds": ["bowl", "jar", "bottle", "mug"],
  "kinematic_position_tolerance_m": 0.002,
  "kinematic_rotation_tolerance_rad": 0.01
}
